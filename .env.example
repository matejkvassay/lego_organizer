# Copy to .env and fill in. Never commit .env.

# --- Brickset (https://brickset.com/tools/webservices/requestkey) ---
BRICKSET_API_KEY=

# --- OpenAI (add-a-set agent + voice transcription) ---
OPENAI_API_KEY=
AGENT_MODEL=gpt-6-luna
AGENT_REASONING_EFFORT=none      # empty = provider default
AGENT_MAX_STEPS=3                # max Brickset searches per AI request
TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Auth (Google OAuth; only ALLOWED_EMAIL may sign in) ---
ALLOWED_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000   # must match the redirect URI registered in Google: $BASE_URL/auth/callback

# --- Storage ---
DATABASE_URL=sqlite:///./data/lego.db

# --- Cloud Run only (leave unset locally) ---
# LITESTREAM_BUCKET=            # GCS bucket name; when set, the container restores the DB from it and replicates to it
# FORWARDED_ALLOW_IPS=*         # trust X-Forwarded-* headers; set ONLY behind Cloud Run's proxy
